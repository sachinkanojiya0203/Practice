<!DOCTYPE html>
<html lang="en">

<head>
    <%-include('./partials/head') %>
        <title>Blog</title>
</head>

<body>
    <%-include('./partials/nav') %>
    
    <div class="container mt-4">
        <h1>
            <%= blog.title %>
        </h1>
        <img src="<%= blog.coverImageURL %>" width="700px">
        <pre class="mt-3"><%= blog.body %></pre>
    </div>
     <div class="container mt-4">
        <img src="<%= blog.createdBy.profile_url %>" alt="" srcset="" width="100px"><%=blog.createdBy.fillname %>
     </div>    

    <%-include('./partials/scripts') %>
</body>

</html>